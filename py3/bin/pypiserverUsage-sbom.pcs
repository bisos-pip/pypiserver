#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.pypiserver/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
pypiserverUsage-sbom.pcs: software bill of materials of the usage side of the pypiserver capability ---
what a host needs to use a package index, local or remote, as opposed to run one. Downloading needs
only pip; uploading needs twine, installed here through pipx at a pinned version.
It does not need the server. pypiserver-sbom.pcs does not pull this sbom in; pypiserverCbs-sbom.pcs,
the sbom of pypiserver-cbs.pcs, runs both.
#+end_org """

from bisos import b
from bisos.b import cs
from bisos.b import b_io

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
from bisos.pypiserver.pypiserverInfo import pypiserverInfo, twineSetupScript

ap = pkgsSeed.aptPkg


def _bash(script: str) -> b.op.Outcome:
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(script)
    if outcome.isProblematic():
        b_io.eh.badOutcome(outcome)
    return outcome


def twineSetup():
    """twine at its pin, through pipx. Not an apt package. Idempotent; reinstalls on a version bump.

    Not in pipxPkgsList: bisos.sbom's pipx step ignores versions and skips installed packages.
    """
    return _bash(twineSetupScript())


aptPkgsList = [
    ap("twineSetup", func=twineSetup),
]

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        i = pypiserverInfo
        descriptionStr = f"""\
** Scope: the usage side of the pypiserver capability -- what a host needs to use a package
   index (this host's or another's), not to run one. Part of bisos.pypiserver.

** What this installs:
  1) twineSetup: twine {i.twineVersion} through pipx, as {i.twineBin}.

** Standalone: this sbom does not need the server. pypiserver-sbom.pcs does not pull it in;
   pypiserver-cbs.pcs runs both, through pypiserverCbs-sbom.pcs.

** To use this host's index (no login to download; admin / {i.adminPassword} to upload):
       pip install {i.pipExtraIndexArgs} <package>
   (--trusted-host: pip ignores an index on plain HTTP otherwise.)
       {i.twineBin} upload --repository-url {i.uploadUrl} -u {i.adminUser} -p {i.adminPassword} dist/*
   It writes no pip.conf or ~/.pypirc: those are the user's.

       pypiserverUsage-sbom.pcs -i sbom_fullUpdate\
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )


def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert
    i = pypiserverInfo

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*pypiserver Usage -- sbom Examples*')
    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Installation*')
    literal("pypiserverUsage-sbom.pcs -i sbom_fullUpdate")

    cs.examples.menuChapter('*Use It*')
    literal(f"{i.twineBin} --version")
    literal(f"{i.twineBin} upload --repository-url {i.uploadUrl} -u {i.adminUser} -p {i.adminPassword} dist/*")
    literal(f"pip download --no-deps {i.pipIndexArgs} <package> -d /tmp")

    cs.examples.menuChapter('*End-Of pypiserver Usage -- sbom Examples*')
    return cmndOutcome
