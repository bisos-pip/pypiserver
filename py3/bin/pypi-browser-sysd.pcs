""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.pypiserver/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
The pypi-browser.service unit: pypi-browser, an ASGI (Starlette) app, run by uvicorn, the ASGI server,
both from pypi-browser's isolated venv (/bisos/venv/py3/isolated/pypiBrowser).
nginx is the reverse proxy in front of it (pypiserver-wvd.pcs); uvicorn trusts its forwarded headers.
It reads its index from PYPI_BROWSER_PYPI_URL in /etc/default/pypi-browser (this host's pypiserver).
Wants= (not Requires=) pypiserver.service: the UI stays up while the index restarts.
#+end_org """

from bisos.debian import systemd_seedInfo
from bisos.debian import systemd_seed as systemd_seed  # noqa

from bisos.pypiserver.pypiserverInfo import pypiserverInfo, sysdServiceLines

def sysdUnitFileFunc() -> str | None:
    """Produce the unit file as a string."""

    i = pypiserverInfo
    if not ( execPath := i.browserVenvBin("uvicorn") ).exists():
        return None

    templateStr = f"""
[Unit]
Description=pypi-browser (web UI of pypiserver)
After=network.target pypiserver.service
Wants=pypiserver.service

[Service]
Type=simple
{sysdServiceLines(i.browserEnvFile)}ExecStart={execPath} --host {i.listenIp} --port {i.browserPortNu} --proxy-headers --forwarded-allow-ips {i.listenIp} pypi_browser.app:app
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
"""
    return templateStr

systemd_seedInfo.setup(
    seedType="sysdSysUnit",
    sysdUnitName="pypi-browser",
    sysdUnitFileFunc=sysdUnitFileFunc,
)
