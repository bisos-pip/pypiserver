#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =PlantedCmndService= for pypiserver.here NGINX virtual-host (capWebVd) --- the index and its browser on one fqdn
#+end_org """

from bisos.b import cs
import collections

from bisos.csSeed import seedsLib

from bisos.webCap import capWebVd_seed  # noqa: F401  # _atExit_

from bisos.webCap import capWebVd_seedInfo
from bisos.pypiserver.pypiserverInfo import pypiserverInfo

serverName = pypiserverInfo.fqdn
# Both listeners are on loopback; nginx proxies to that address rather than to the .here one.
proxyIp = pypiserverInfo.listenIp
proxyPort = pypiserverInfo.portNu
browserPort = pypiserverInfo.browserPortNu

def wvdConfigFunc() -> str:
    """One fqdn, two programs: pypi-browser at / and pypiserver for the index paths and uploads.

    pypiserver takes uploads as a POST to /, the path that is pypi-browser's home page, so / is
    routed by request method, with a map (in the http context; this file is included there) rather
    than nginx's fragile `if`. The map's name carries the fqdn's, to be unique among vhosts.
    client_max_body_size: nginx's default of 1m would refuse most uploads.
    """
    return f"""\
map $request_method $pypiserverHereRoot {{
    POST     {proxyIp}:{proxyPort};
    default  {proxyIp}:{browserPort};
}}

server {{
    listen 80;
    server_name {serverName};
    client_max_body_size 200m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The index: what pip reads.
    location /simple {{
        proxy_pass http://{proxyIp}:{proxyPort};
    }}
    location /packages {{
        proxy_pass http://{proxyIp}:{proxyPort};
    }}

    # Uploads (twine POSTs to /) to pypiserver; GET / is pypi-browser's home page.
    location = / {{
        proxy_pass http://$pypiserverHereRoot;
    }}

    # Everything else: pypi-browser.
    location / {{
        proxy_pass http://{proxyIp}:{browserPort};
    }}
}}
"""

capWebVd_seedInfo.setup(
    serverName=serverName,
    proxyPort=proxyPort,
    wvdConfigFunc=wvdConfigFunc,
)

from bisos.csSeed import csCmndsList_seedInfo
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("configFileStdout", pars={'cls': 'configFile_nginxVd'},),
    csCmnd("configFileUpdate", pars={'cls': 'configFile_nginxVd', 'runAs': 'root'},),
    csCmnd("webVd_enable",),
    csCmnd("webVd_verify",),
    csCmnd("webVd_resolve",),
    csCmnd("webVd_fqdnPing",),
]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)
