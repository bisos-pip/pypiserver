#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.pypiserver/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
pypiserver-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed
ws: An Web Service  --- /Service Component/ --- pypiserver and pypi-browser as pypiserver.here
n:  No Data    -- Materialization is purely based on Realm-BPO
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle: pypiserverCbs-sbom.pcs, which runs pypiserver-sbom.pcs (account, pypiserver and
pypi-browser into the shared venv, config) and pypiserverUsage-sbom.pcs (twine); the pypiserver
and pypi-browser units; and pypiserver-assemble.cs (pypiserver.here dns + nginx vhost).
cba_seed takes one sbom, hence pypiserverCbs-sbom.pcs rather than both names here.
#+end_org """

from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="systemd",  # Extend using cba_sysd_seed.setup
    loader=None,
    sbom="pypiserverCbs-sbom.pcs",
    assemble="pypiserver-assemble.cs",
    materialize=None,
)

# The index first, then the UI that reads it.
sysdUnitsListPypiserver = [
    cba_sysd_seed.sysdUnit("pypiserver",    "pypiserver-sysd.pcs"),
    cba_sysd_seed.sysdUnit("pypi-browser",  "pypi-browser-sysd.pcs"),
]

cba_sysd_seed.setup(
    sysdUnitsList=sysdUnitsListPypiserver,
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
