""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.pypiserver/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
The pypiserver.service unit: the package index, a WSGI app served by waitress (--server waitress).
Flags come from ARGS in /etc/default/pypiserver, expanded as separate words ($ARGS).
#+end_org """

from bisos.debian import systemd_seedInfo
from bisos.debian import systemd_seed as systemd_seed  # noqa

from bisos.pypiserver.pypiserverInfo import pypiserverInfo, sysdServiceLines

def sysdUnitFileFunc() -> str | None:
    """Produce the unit file as a string."""

    # In the shared venv, not on PATH.
    if not ( execPath := pypiserverInfo.venvBin("pypi-server") ).exists():
        return None

    templateStr = f"""
[Unit]
Description=pypiserver (private Python package index)
After=network.target

[Service]
Type=simple
{sysdServiceLines(pypiserverInfo.envFile)}ExecStart={execPath} $ARGS
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
"""
    return templateStr

systemd_seedInfo.setup(
    seedType="sysdSysUnit",
    sysdUnitName="pypiserver",
    sysdUnitFileFunc=sysdUnitFileFunc,
)
